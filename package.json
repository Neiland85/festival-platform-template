{
  "name": "festival-platform-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build",
    "prepare": "husky",
    "db:migrate": "psql $DATABASE_URL -f sql/schema.sql && for f in migrations/*.sql; do echo \"Running $f...\"; psql $DATABASE_URL -f \"$f\"; done",
    "db:migrate:check": "psql $DATABASE_URL -c \"SELECT tablename FROM pg_tables WHERE schemaname = 'public' ORDER BY tablename;\"",
    "seed:spud-demo": "tsx scripts/seed-spud-demo.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@sentry/nextjs": "^9.27.0",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "next": "^15.5.15",
    "next-intl": "^4.12.0",
    "next-sanity": "^9.12.2",
    "openai": "6.37.0",
    "otpauth": "9.5.1",
    "pg": "^8.16.0",
    "qrcode": "1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sanity": "^3.90.1",
    "stripe": "^18.2.0",
    "zod": "^3.25.17"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.19.0",
    "@types/pg": "^8.15.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "4.7.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^10.3.0",
    "eslint-config-next": "^15.3.3",
    "eslint-plugin-security": "^4.0.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.14",
    "semantic-release": "^25.0.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "overrides": {
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "brace-expansion@<5.0.5": ">=5.0.5",
      "prismjs@<1.30.0": ">=1.30.0",
      "esbuild@<=0.24.2": ">=0.25.0"
    }
  }
}
