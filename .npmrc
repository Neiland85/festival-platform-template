# ── Supply Chain Security ─────────────────────────────
# Prevents ransomware entry via malicious npm lifecycle scripts.
#
# WHAT THIS PREVENTS:
#   - Malicious postinstall scripts executing arbitrary code
#   - Typosquatted packages running install hooks
#   - Dependency confusion attacks via registry manipulation

# Block all lifecycle scripts by default (postinstall, preinstall, etc.)
# Only explicitly approved packages can run scripts via pnpm approve-builds
ignore-scripts=true

# Enforce exact versions (no semver ranges that could pull malicious updates)
save-exact=true

# Use the official npm registry only (prevents registry confusion attacks)
registry=https://registry.npmjs.org/

# Enforce lockfile integrity — fail if lockfile is out of sync
frozen-lockfile=true
